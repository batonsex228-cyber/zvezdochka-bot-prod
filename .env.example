# ZVEZDOCHKA SUPPORT BOT v6.0 — VK-FIRST
# Never commit a real .env or any token.

# Required VK community credentials
VK_GROUP_ID=0
VK_GROUP_TOKEN=
VK_API_VERSION=5.199

# Recommended manager personal VK ID (without id/URL)
VK_MANAGER_USER_ID=0

# Official public community used as secondary profile evidence
VK_SOURCE_DOMAIN=zvezdochkaooorazvitie

# Optional future import of recent wall posts. The bot works without it.
VK_CONTENT_TOKEN=
VK_SOURCE_POST_LIMIT=10
VK_SOURCE_MAX_AGE_DAYS=60

# Website / knowledge base
SITE_URL=https://zvezdaglazov.ru/
KB_FILE=runtime/knowledge_base.json
DB_FILE=runtime/bot.sqlite3
CRAWL_MAX_PAGES=40
AUTO_REFRESH_KB=true
KB_REFRESH_HOURS=6
KB_MAX_AGE_HOURS=24

# Optional grounded AI layer. Without it only strict FAQ + human handoff is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
FAQ_MIN_SCORE=0.72
RETRIEVAL_MIN_SCORE=0.48

CONTEXT_TTL_MINUTES=15
NEWSLETTERS_ENABLED=true
SHOW_SOURCE_LINKS=true
DEBUG=false
CAMP_NAME=ДЗЛ «Звёздочка»

# Optional booking module via Google Apps Script + Google Sheets.
# Keep disabled until the Web App URL and shared secret are configured.
BOOKINGS_ENABLED=false
BOOKING_API_URL=
BOOKING_API_SECRET=
BOOKING_TIMEZONE=Europe/Samara
BOOKING_HOLD_MINUTES=15
BOOKING_TIMEOUT_SECONDS=15

# v6.0 Smart Handoff + manager-approved Knowledge Loop.
# Safe rollout: both features are OFF until explicitly enabled on the server.
SMART_HANDOFF_ENABLED=false
SMART_HANDOFF_TTL_MINUTES=90
KNOWLEDGE_LOOP_ENABLED=false

# v6.0.4 shift applications — enable only after Apps Script update and privacy approval
SHIFT_BOOKINGS_ENABLED=false
SHIFT_PRIVACY_POLICY_URL=
SHIFT_ACTIVE_NUMBERS=1,2,3
# Requires privacy/legal approval and Apps Script property SHIFT_PII_EXPORT_ALLOWED=true
SHIFT_EXPORT_PII_TO_GOOGLE=false
